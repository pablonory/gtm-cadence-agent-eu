# === macOS junk ===
.DS_Store
.AppleDouble
__MACOSX/

# === SECRETS — never commit (keys live per-user, not in git) ===
.mcp.json
.env
.env.*
*.key
*.pem
**/credentials*.json
**/*secret*.json
# keep the templates:
!.mcp.json.example
!.mcp.*.example.json
!.env.example

# === Local machine settings ===
.claude/settings.local.json

# === Caches / scratch ===
__pycache__/
*.pyc
.venv/
node_modules/
# Firecrawl CLI local scrape cache — can hold real scraped prospect-site content
.firecrawl/

# === Real prospect data — never commit ===
# The accounts sheet lives in Google Drive; any local export stays out of git.
input/accounts_local.*
input/*.csv

# === Generated per-run outputs (real deliverables go to Google Drive) ===
output/accounts/*/
output/weekly/*
# Stage-1 delta/state snapshots — hold real prospect data (see directives/signals/_delta_state.md)
output/state/*
# Stage-2b raw Gong pulls — real call data / PII (see scripts/gong_pull.py)
output/gong/*
# Reactivation-deal bundles — deal history, transcripts, logged emails; real PII (see
# scripts/reactivation_bundle.py). Never commit; the agent reads these, writes only the synthesis
# to HubSpot properties. Covers the .digest.json pre-slices from scripts/bundle_digest.py too.
output/reactivation/*
# Per-account brief payloads — the DENSEST PII in the repo: verbatim prospect quotes lifted from Gong
# transcripts, deal amounts, closed-lost reasons, contact names and email addresses. (Added in the US
# repo 2026-08-24 when the directory turned up untracked; ported at fork-sync.) The payload is a
# staging file on the way to HubSpot; HubSpot is where it belongs.
output/briefs/*
# Generated local copies of shareable reports (the canonical version is the published artifact)
output/reports/*
# keep the folder skeleton
!output/**/.gitkeep
!output/**/README.md
