# Template — COMMITTABLE. Copy to a gitignored .env and fill in real values.
#   cp .env.example .env   then edit .env   (never commit .env — it's gitignored)
# scripts/gong_pull.py auto-loads .env from the repo root.
# ⚠️ PLACEHOLDERS ONLY in this file — real secrets go in .env, NOT here.

# --- Gong REST API (primary Stage-2b source) ---
# Developer API credentials (Basic auth). Gong: Company Settings → API.
GONG_ACCESS_KEY=
GONG_SECRET=
# Optional — only set if your tenant uses a non-default API base (e.g. https://us-XXXXX.api.gong.io).
GONG_API_BASE=https://api.gong.io

# --- Apify (Stage-1 open_jobs augment, optional/not wired yet) ---
APIFY_TOKEN=

# --- Firecrawl (paid plan — premium crawling for signal research: JS-rendered sites, sites that
# block WebFetch/WebSearch, structured extraction). `npx firecrawl-cli env` writes this for you.
# Powers the `firecrawl` MCP server (see .mcp.json.example) and the `firecrawl` CLI directly.
FIRECRAWL_API_KEY=
